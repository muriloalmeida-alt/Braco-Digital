// BRAÇO — App Service schema (Sprint 01 slice)
// Ver docs/technical/03-data-model.md para o modelo conceitual completo.
// Este schema implementa só o subconjunto necessário para US01-US06, US53, US54.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Papel do usuário dentro de uma empresa (RBAC) — docs/technical/04-multi-tenancy.md §3
enum Role {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

/// Catalog Availability — separado de EmployeeStatus.
/// docs/design/09-product-patterns.md §1.1, docs/design/18-catalog-availability-ui-spec.md
enum CatalogAvailability {
  AVAILABLE
  COMING_SOON
}

/// Employee Status — docs/design/09-product-patterns.md §2, docs/design/12-status-and-states.md
enum EmployeeStatus {
  CONTRATADO
  PREPARANDO
  PRONTO
  TRABALHANDO
  PAUSADO
  PRECISA_DE_ATENCAO
  DESATIVADO
}

/// US07 — docs/design/22-work-manual-content-model.md §4.
enum ServiceMode {
  PRESENCIAL
  ONLINE
  AMBOS
}

/// US08 — docs/design/22-work-manual-content-model.md §5.
enum ProductServiceKind {
  PRODUTO
  SERVICO
}

enum PricingMode {
  FIXO
  A_PARTIR_DE
  SOB_CONSULTA
  NAO_INFORMAR
}

/// Autonomia — docs/design/22-work-manual-content-model.md §8. Ordem de
/// permissividade PODE_DECIDIR > PODE_DECIDIR_SOB_REGRAS > PRECISA_HUMANO
/// é codificada em `autonomy-catalog.ts` (rank), não neste enum.
enum AutonomyLevel {
  PODE_DECIDIR
  PODE_DECIDIR_SOB_REGRAS
  PRECISA_HUMANO
}

/// US12 — docs/design/22-work-manual-content-model.md §9.
enum ResponsibleKind {
  PRINCIPAL
  RESERVA
}

/// US13 — docs/design/22-work-manual-content-model.md §10.
enum CommunicationTone {
  PROFISSIONAL_PROXIMO
  ACOLHEDOR
  DIRETO_OBJETIVO
  FORMAL
}

enum CommunicationAddressing {
  PRIMEIRO_NOME
  SENHOR_SENHORA
  NEUTRO_SEM_NOME
}

enum CommunicationLength {
  CURTAS_OBJETIVAS
  EQUILIBRADAS
  DETALHADAS_QUANDO_NECESSARIO
}

enum CommunicationEmojis {
  NAO_USAR
  USAR_COM_MODERACAO
  USAR_QUANDO_FIZER_SENTIDO
}

/// US14 — docs/design/24-work-resources-ui-spec.md §3/§4.
enum IntegrationType {
  WHATSAPP
  GOOGLE_CALENDAR
  GOOGLE_TASKS
}

/// docs/design/24-work-resources-ui-spec.md §4. NOT_NECESSARY é derivado em
/// runtime (nunca persistido) quando nenhuma responsabilidade exige o
/// recurso — ver `resources.service.ts`.
enum IntegrationStatus {
  NOT_CONFIGURED
  CONNECTING
  CONNECTED
  NEEDS_ATTENTION
  DISCONNECTED
}

/// Product Review 01 — origem da conexão de um recurso. Guarda contra o
/// caso "simulação vira PRONTO em produção" (docs/technical/17-technical-
/// decisions.md TD19): SIMULATED nunca satisfaz Recursos/PRONTO quando o
/// ambiente é produção, independente do valor de `status`.
enum IntegrationConnectionMode {
  SIMULATED
  REAL
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  document  String?
  vertical  String?
  timezone  String   @default("America/Sao_Paulo")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  // --- US07 — Empresa (docs/design/22-work-manual-content-model.md §4) ---
  // Contexto compartilhado: pertence à Company, não a um DigitalEmployee
  // (§14 Ownership). `timezone` acima já cobre "Fuso horário".
  attendanceName   String?      @map("attendance_name")
  about            String?
  serviceMode      ServiceMode? @map("service_mode")
  address          String?
  businessHours    Json?        @map("business_hours")
  website          String?
  socialHandle     String?      @map("social_handle")
  generalNotes     String?      @map("general_notes")
  profileUpdatedAt DateTime?    @map("profile_updated_at")

  memberships      CompanyMembership[]
  digitalEmployees DigitalEmployee[]
  idempotencyKeys  IdempotencyKey[]
  products         ProductService[]
  integrations     Integration[]

  zernioConnection         ZernioConnection?
  zernioOnboardingAttempts ZernioOnboardingAttempt[]
  zernioWebhookEvents      ZernioWebhookEvent[]
  zernioMessages           ZernioMessage[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  memberships              CompanyMembership[]
  responsibleFor           EmployeeResponsible[]
  zernioOnboardingAttempts ZernioOnboardingAttempt[]

  @@map("users")
}

/// Liga User a Company com um papel — um User pode pertencer a mais de uma
/// empresa (docs/technical/03-data-model.md, seção "User / CompanyMembership").
model CompanyMembership {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  userId    String   @map("user_id")
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_memberships")
}

// ---------------------------------------------------------------------------
// Catálogo (global, não pertence a nenhuma empresa)
// ---------------------------------------------------------------------------

/// Catálogo de produto — docs/04-employee-catalog.md. Global, seed-only no
/// MVP (não editável por gestor).
model EmployeeType {
  id               String              @id @default(uuid())
  key              String              @unique
  name             String
  role             String
  mission          String
  expectedResult   String              @map("expected_result")
  responsibilities String[]
  availability     CatalogAvailability @default(COMING_SOON)
  sortOrder        Int                 @default(0) @map("sort_order")

  digitalEmployees DigitalEmployee[]

  @@map("employee_types")
}

// ---------------------------------------------------------------------------
// Funcionário Digital (tenant-scoped)
// ---------------------------------------------------------------------------

model DigitalEmployee {
  id             String         @id @default(uuid())
  companyId      String         @map("company_id")
  employeeTypeId String         @map("employee_type_id")
  name           String?
  status         EmployeeStatus @default(CONTRATADO)
  hiredAt        DateTime       @default(now()) @map("hired_at")
  activatedAt    DateTime?      @map("activated_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeType EmployeeType @relation(fields: [employeeTypeId], references: [id])
  workManual   WorkManual?

  responsibilities   EmployeeResponsibility[]
  rules              WorkManualRule[]
  autonomyPolicies   EmployeeAutonomyPolicy[]
  responsibles       EmployeeResponsible[]
  communicationStyle EmployeeCommunicationStyle?

  @@index([companyId])
  @@map("digital_employees")
}

/// Manual de Trabalho — nesta fase (US06) só a estrutura de seções e seu
/// estado inicial/incompleto. Preenchimento de conteúdo é US07-US15
/// (Sprint 02) e não é modelado aqui ainda.
model WorkManual {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  digitalEmployeeId String   @unique @map("digital_employee_id")
  status            String   @default("not_started")
  sections          Json
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // US10 — "Não tenho regras adicionais" é uma decisão explícita do
  // gestor, distinta de "lista de regras vazia porque ele ainda não
  // mexeu na etapa" (docs/design/22-work-manual-content-model.md §7).
  rulesAcknowledgedNoAdditional Boolean @default(false) @map("rules_ack_no_additional")

  digitalEmployee DigitalEmployee @relation(fields: [digitalEmployeeId], references: [id], onDelete: Cascade)

  // company_id é denormalizado aqui (não é FK Prisma para Company porque a
  // relação de negócio é via DigitalEmployee) propositalmente: sustenta a
  // política de RLS sem exigir JOIN — docs/technical/03-data-model.md §4
  // ("toda tabela de tenant tem company_id NOT NULL").
  @@index([companyId])
  @@map("work_manuals")
}

// ---------------------------------------------------------------------------
// Sprint 02 — Track A: conteúdo do Manual de Trabalho
// docs/design/22-work-manual-content-model.md, docs/technical/17-
// technical-decisions.md TD13.
// ---------------------------------------------------------------------------

/// US08 — Produtos e serviços. Compartilhado pela Company (§14 Ownership),
/// não copiado por funcionário.
model ProductService {
  id                String             @id @default(uuid())
  companyId         String             @map("company_id")
  name              String
  kind              ProductServiceKind
  clientDescription String             @map("client_description")
  pricingMode       PricingMode        @map("pricing_mode")
  price             Decimal?           @db.Decimal(12, 2)
  schedulable       Boolean            @default(false)
  durationMinutes   Int?               @map("duration_minutes")
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("products_services")
}

/// US09 — Responsabilidades habilitadas por funcionário. O catálogo em si
/// (quais chaves existem, quais são essenciais, dependências de recurso)
/// é fixo em código (`responsibility-catalog.ts`) — aqui só persiste a
/// seleção (`enabled`) por funcionário.
model EmployeeResponsibility {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  digitalEmployeeId String   @map("digital_employee_id")
  key               String
  enabled           Boolean  @default(true)
  updatedAt         DateTime @updatedAt @map("updated_at")

  digitalEmployee DigitalEmployee @relation(fields: [digitalEmployeeId], references: [id], onDelete: Cascade)

  @@unique([digitalEmployeeId, key])
  @@index([companyId])
  @@map("employee_responsibilities")
}

/// US10 — Regras da empresa específicas do funcionário (não confundir com
/// System Limits, que são fixos/não editáveis e vivem em código —
/// `system-limits.ts`, nunca nesta tabela).
model WorkManualRule {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  digitalEmployeeId String   @map("digital_employee_id")
  text              String
  appliesWhen       String?  @map("applies_when")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  digitalEmployee DigitalEmployee @relation(fields: [digitalEmployeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([digitalEmployeeId])
  @@map("work_manual_rules")
}

/// US11 — Autonomia por responsabilidade. Recomendação inicial e teto
/// máximo são constantes de código (`autonomy-catalog.ts`, PD7/TD14) — só
/// o nível *escolhido pelo gestor* (e a condição, quando 🟡) persiste aqui.
model EmployeeAutonomyPolicy {
  id                String        @id @default(uuid())
  companyId         String        @map("company_id")
  digitalEmployeeId String        @map("digital_employee_id")
  responsibilityKey String        @map("responsibility_key")
  level             AutonomyLevel
  condition         String?
  updatedAt         DateTime      @updatedAt @map("updated_at")

  digitalEmployee DigitalEmployee @relation(fields: [digitalEmployeeId], references: [id], onDelete: Cascade)

  @@unique([digitalEmployeeId, responsibilityKey])
  @@index([companyId])
  @@map("employee_autonomy_policies")
}

/// US12 — Pessoas e responsáveis. `userId` deve referenciar um
/// `CompanyMembership` ativo da mesma empresa (validado no service, não
/// só por FK — um usuário pode ter sido removido da empresa depois).
model EmployeeResponsible {
  id                String          @id @default(uuid())
  companyId         String          @map("company_id")
  digitalEmployeeId String          @map("digital_employee_id")
  userId            String          @map("user_id")
  kind              ResponsibleKind
  updatedAt         DateTime        @updatedAt @map("updated_at")

  digitalEmployee DigitalEmployee @relation(fields: [digitalEmployeeId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([digitalEmployeeId, kind])
  @@index([companyId])
  @@map("employee_responsibles")
}

/// US13 — Estilo de comunicação, 1:1 com o funcionário.
model EmployeeCommunicationStyle {
  id                String                   @id @default(uuid())
  companyId         String                   @map("company_id")
  digitalEmployeeId String                   @unique @map("digital_employee_id")
  tone              CommunicationTone?
  addressing        CommunicationAddressing?
  length            CommunicationLength?
  emojis            CommunicationEmojis?
  preferredTerms    String[]                 @map("preferred_terms")
  avoidTerms        String[]                 @map("avoid_terms")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  digitalEmployee DigitalEmployee @relation(fields: [digitalEmployeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("employee_communication_styles")
}

/// US14 — Recursos de trabalho. Escopo da Company (a conta/número
/// conectado é da empresa, não do funcionário — docs/technical/20-
/// sprint-02-tech-readiness.md §4); a obrigatoriedade por funcionário é
/// sempre derivada em runtime das responsabilidades habilitadas, nunca
/// uma coluna própria (evita dessincronia).
model Integration {
  id                   String                    @id @default(uuid())
  companyId            String                    @map("company_id")
  type                 IntegrationType
  status               IntegrationStatus         @default(NOT_CONFIGURED)
  externalAccountRef   String?                   @map("external_account_ref")
  // Placeholder até KMS/secrets manager existir no ambiente
  // (docs/technical/20-sprint-02-tech-readiness.md §24.2) — nunca
  // credencial real em texto plano; nesta sprint não há OAuth real
  // conectado, então o campo fica vazio em uso normal.
  credentialsEncrypted String?                   @map("credentials_encrypted")
  // Product Review 01: nunca inferir "verificado" a partir de status
  // sozinho — SIMULATED é o único valor que o código de hoje sabe
  // produzir (não há OAuth real implementado ainda); REAL fica
  // reservado para quando o callback real existir. A autoridade de
  // completude (PreparationReadinessService) exige REAL em produção.
  connectionMode       IntegrationConnectionMode @default(SIMULATED) @map("connection_mode")
  connectedAt          DateTime?                 @map("connected_at")
  lastSyncAt           DateTime?                 @map("last_sync_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@index([companyId])
  @@map("integrations")
}

// ---------------------------------------------------------------------------
// Idempotência (US03 — evitar contratação duplicada)
// ---------------------------------------------------------------------------

model IdempotencyKey {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  key          String
  requestHash  String   @map("request_hash")
  responseBody Json     @map("response_body")
  statusCode   Int      @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Integração real de WhatsApp via Zernio (issue #30, US14)
// docs/technical/21-zernio-whatsapp-integration.md
//
// `Integration` (acima, tipo WHATSAPP) continua sendo o que
// `ResourcesService`/`PreparationReadinessService` leem (status/
// connectionMode/externalAccountRef/connectedAt) — TD19 e o guard de
// produção não mudam nem sabem que "Zernio" existe. As tabelas abaixo
// guardam o detalhe específico do provedor; `ZernioConnectionService`
// mantém a linha genérica em `integrations` em sincronia com elas.
// ---------------------------------------------------------------------------

/// Estado detalhado da conexão — mais granular que `IntegrationStatus`
/// (compartilhado entre WHATSAPP/GOOGLE_CALENDAR/GOOGLE_TASKS) porque só
/// o Zernio hoje tem um provedor real por trás para reportar isso.
enum ZernioConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  DEGRADED
  DISCONNECTED
  FAILED
}

/// Uma por empresa — "usar um profileId Zernio por empresa/tenant"
/// (decisão de arquitetura da issue #30). `accountId`/`profileId` únicos
/// globalmente: impede que o mesmo profile/número Zernio seja associado a
/// duas empresas por engano (IDOR entre tenants).
model ZernioConnection {
  id        String @id @default(uuid())
  companyId String @unique @map("company_id")

  profileId String? @unique @map("profile_id")
  accountId String? @unique @map("account_id")

  phoneNumber String? @map("phone_number")
  displayName String? @map("display_name")

  status                 ZernioConnectionStatus @default(NOT_CONNECTED)
  // Espelho textual do campo cru retornado pelo Zernio (`phone.status`,
  // ex.: "CONNECTED") — `status` acima é o que este código decide a
  // partir dele; `providerStatus` é o dado bruto, para auditoria/debug
  // sem precisar reinterpretar a decisão.
  providerStatus         String?                @map("provider_status")
  qualityRating          String?                @map("quality_rating")
  nameStatus             String?                @map("name_status")
  wabaVerificationStatus String?                @map("waba_verification_status")

  lastHealthCheckAt DateTime? @map("last_health_check_at")
  lastWebhookAt     DateTime? @map("last_webhook_at")
  connectedAt       DateTime? @map("connected_at")
  disconnectedAt    DateTime? @map("disconnected_at")
  failureReason     String?   @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("zernio_connections")
}

/// Correlação interna de uso único do onboarding (Embedded Signup),
/// criada ANTES de redirecionar o usuário ao Zernio e consumida no
/// callback. "Não confiar somente no state remoto" (issue #30): o `id`
/// aqui — não o `state` que o Zernio devolve — é a fonte de verdade que o
/// callback valida (pertence ao tenant certo, não expirou, não foi usada).
model ZernioOnboardingAttempt {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  initiatedByUserId String    @map("initiated_by_user_id")
  profileId         String    @map("profile_id")
  expiresAt         DateTime  @map("expires_at")
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  initiatedByUser User    @relation(fields: [initiatedByUserId], references: [id])

  @@index([companyId])
  @@map("zernio_onboarding_attempts")
}

/// Deduplicação persistente de webhooks (Zernio entrega "at least once").
/// `eventId` == `X-Zernio-Event-Id` / `payload.id` — único: uma segunda
/// entrega do mesmo evento colide na inserção, nunca reprocessa efeito.
model ZernioWebhookEvent {
  id              String    @id @default(uuid())
  eventId         String    @unique @map("event_id")
  eventType       String    @map("event_type")
  // Resolvido a partir de accountId/profileId do payload — nulo só quando
  // a resolução de tenant falha (evento órfão, ver zernio-webhook.service.ts).
  companyId       String?   @map("company_id")
  payload         Json
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  processingError String?   @map("processing_error")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("zernio_webhook_events")
}

enum ZernioMessageDirection {
  INBOUND
  OUTBOUND
}

enum ZernioMessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

/// Registro mínimo do ciclo de vida de uma mensagem — o bastante para o
/// loop enviar→status pedido pela issue #30. Não é o domínio de
/// Conversation/Message/WorkEvent do Runtime (docs/technical/03-data-
/// model.md) — esse domínio não existe neste código ainda e está fora do
/// escopo desta integração (nenhuma lógica de IA/Policy Engine aqui).
model ZernioMessage {
  id                String                 @id @default(uuid())
  companyId         String                 @map("company_id")
  direction         ZernioMessageDirection
  conversationId    String                 @map("conversation_id")
  platformMessageId String                 @unique @map("platform_message_id")
  text              String?
  status            ZernioMessageStatus
  // Preferir businessScopedUserId; phoneNumber é fallback (issue #30) —
  // nunca a chave estável de identidade do contato, só o remetente cru.
  senderIdentity    String?                @map("sender_identity")
  standby           Boolean                @default(false)
  idempotencyKey    String?                @map("idempotency_key")
  failureReason     String?                @map("failure_reason")
  sentAt            DateTime?              @map("sent_at")
  deliveredAt       DateTime?              @map("delivered_at")
  readAt            DateTime?              @map("read_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, conversationId])
  @@map("zernio_messages")
}

/// Marcador de plataforma (não por tenant — assim como `EmployeeType`, sem
/// RLS de propósito): a assinatura de webhook do Zernio é uma por conta
/// Zernio inteira, não por empresa cliente do BRAÇO. Linha única
/// (`id = "default"`) usada por `ensureWebhookRegistered()` para nunca
/// criar uma segunda assinatura a cada deploy — reaproveita ou atualiza a
/// existente quando a URL/eventos mudam.
model ZernioWebhookRegistration {
  id           String   @id @default("default")
  url          String
  eventsHash   String   @map("events_hash")
  registeredAt DateTime @default(now()) @map("registered_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("zernio_webhook_registrations")
}

// ---------------------------------------------------------------------------
// Track B — Growth / Monte sua equipe (público, sem tenant)
// docs/technical/20-sprint-02-tech-readiness.md §5, §16, TD15.
// ---------------------------------------------------------------------------

/// Faixas de tamanho de equipe informadas no diagnóstico público.
/// docs/prd/04-aquisicao-e-diagnostico-de-equipe.md §8.
enum TeamSizeRange {
  SO_EU
  DE_2_A_5
  DE_6_A_20
  DE_21_A_50
  MAIS_DE_50
}

/// Faixas de volume aproximado informadas no diagnóstico público.
/// docs/prd/04-aquisicao-e-diagnostico-de-equipe.md §11.
enum DiagnosticVolumeRange {
  ATE_10
  DE_11_A_30
  DE_31_A_100
  MAIS_DE_100
  NAO_SEI_DIZER
}

/// US83 — Lead capturado no fim do diagnóstico público "Monte sua equipe".
/// Não tem `company_id`: não pertence a nenhum tenant (não cria Company,
/// User nem contratação — PRD 04 §19). Isolamento de acesso é feito por
/// role de banco dedicada (TD15), não por RLS por empresa.
model Lead {
  id          String                @id @default(uuid())
  name        String
  companyName String                @map("company_name")
  whatsapp    String
  email       String?
  segment     String
  teamSize    TeamSizeRange         @map("team_size")
  needs       String[]
  priority    String
  volume      DiagnosticVolumeRange
  ranking     Json
  ruleVersion String                @map("rule_version")
  // Enquanto o Launch Gate de privacidade (PD6) não estiver validado
  // juridicamente, todo lead capturado fora de produção real é marcado
  // sintético — nunca um mock disfarçado de captação real (ver
  // PublicLeadCaptureGuard e docs/technical/17-technical-decisions.md
  // TD19).
  isSynthetic Boolean               @default(true) @map("is_synthetic")
  source      String
  createdAt   DateTime              @default(now()) @map("created_at")

  @@map("leads")
}
