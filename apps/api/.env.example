DATABASE_URL="postgresql://braco:braco_dev_password@localhost:5432/braco_dev?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="900s"
PORT=3001

# Empresa/usuário de teste criados por `npm run seed` (prisma/seed.ts).
# Opcionais — sem elas, o seed usa os defaults de desenvolvimento abaixo.
# Nunca crie a empresa de teste rodando um script/comando à mão: ajuste
# estas variáveis no .env do ambiente (dev/staging/CI) e rode o seed.
# SEED_COMPANY_ID="00000000-0000-0000-0000-000000000001"
# SEED_COMPANY_NAME="Clínica Vida (demo)"
# SEED_COMPANY_DOCUMENT="00.000.000/0001-00"
# SEED_COMPANY_VERTICAL="clinica"
# SEED_COMPANY_TIMEZONE="America/Sao_Paulo"
# SEED_OWNER_EMAIL="owner@clinicavida.demo"
# SEED_OWNER_NAME="Murilo (Owner demo)"
# SEED_OWNER_PASSWORD="braco123"

# Produção/Railway:
# - DATABASE_URL: no Railway, referencie o plugin Postgres do projeto
#   (ex.: ${{Postgres.DATABASE_URL}}) em vez de hardcoded.
# - PORT: o Railway injeta automaticamente; não fixar em produção.
# - JWT_SECRET: gerar um valor forte por ambiente, nunca reaproveitar o de dev.
# - CORS_ORIGIN: URL(s) públicas do serviço apps/web, separadas por vírgula
#   (ex.: https://braco-web.up.railway.app). Sem isso, o navegador bloqueia
#   as chamadas do frontend hospedado em outro domínio.
CORS_ORIGIN=
