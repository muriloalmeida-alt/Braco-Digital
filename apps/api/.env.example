DATABASE_URL="postgresql://braco:braco_dev_password@localhost:5432/braco_dev?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="900s"
PORT=3001

# Empresa/usuário de teste criados por `npm run seed` (prisma/seed.ts).
# Opcionais — sem elas, o seed usa os defaults de desenvolvimento abaixo.
# Nunca crie a empresa de teste rodando um script/comando à mão: ajuste
# estas variáveis no .env do ambiente (dev/staging/CI) e rode o seed.
# SEED_COMPANY_ID="00000000-0000-0000-0000-000000000001"
# SEED_COMPANY_NAME="Clínica Vida (demo)"
# SEED_COMPANY_DOCUMENT="00.000.000/0001-00"
# SEED_COMPANY_VERTICAL="clinica"
# SEED_COMPANY_TIMEZONE="America/Sao_Paulo"
# SEED_OWNER_EMAIL="owner@clinicavida.demo"
# SEED_OWNER_NAME="Murilo (Owner demo)"
# SEED_OWNER_PASSWORD="braco123"

# Integração real de WhatsApp via Zernio (issue #30, US14). Opcionais —
# sem ZERNIO_API_KEY, a integração fica desabilitada (US14 permanece
# Parcial), o que é um estado normal, não um erro. Se ZERNIO_API_KEY for
# definida, TODAS as outras passam a ser obrigatórias (o app falha no
# startup em produção se estiverem faltando — ver zernio-config.ts).
# NUNCA versionar valores reais aqui nem em nenhum outro arquivo.
# ZERNIO_BASE_URL="https://zernio.com/api/v1"
# ZERNIO_API_KEY="sk_..."
# ZERNIO_WEBHOOK_SECRET="..."
# ZERNIO_REDIRECT_URL="https://<domínio-do-apps-api>/integrations/zernio/whatsapp/callback"
# ZERNIO_REQUEST_TIMEOUT_MS=10000

# Integração real de Google Calendar + Google Tasks via OAuth (issue #31,
# US14). Opcionais — sem GOOGLE_CLIENT_ID, a integração fica desabilitada
# (US14 permanece Parcial nesse recurso), estado normal, não um erro. Se
# GOOGLE_CLIENT_ID for definida, TODAS as outras passam a ser obrigatórias
# (o app falha no startup em produção se estiverem faltando — ver
# google-config.ts). NUNCA versionar valores reais aqui nem em nenhum
# outro arquivo.
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# GOOGLE_REDIRECT_URI="https://<domínio-do-apps-api>/integrations/google/callback"
# GOOGLE_REQUEST_TIMEOUT_MS=10000
# Chave simétrica (base64, 32 bytes — gere com `openssl rand -base64 32`)
# usada para cifrar os tokens OAuth antes de persistir
# (GoogleConnection.access_token_encrypted/refresh_token_encrypted).
# ATENÇÃO: esta é uma cifra real (AES-256-GCM), mas NÃO satisfaz sozinha o
# requisito de produção de docs/technical/10-security-lgpd.md §4 (chave
# gerida por KMS com rotação) — ver docs/technical/22-google-workspace-
# integration.md, seção "Criptografia", antes de habilitar em produção
# real com dados de clientes.
# GOOGLE_CREDENTIALS_ENCRYPTION_KEY="..."

# Produção/Railway:
# - DATABASE_URL: no Railway, referencie o plugin Postgres do projeto
#   (ex.: ${{Postgres.DATABASE_URL}}) em vez de hardcoded.
# - PORT: o Railway injeta automaticamente; não fixar em produção.
# - JWT_SECRET: gerar um valor forte por ambiente, nunca reaproveitar o de dev.
# - CORS_ORIGIN: URL(s) públicas do serviço apps/web, separadas por vírgula
#   (ex.: https://braco-web.up.railway.app). Sem isso, o navegador bloqueia
#   as chamadas do frontend hospedado em outro domínio.
CORS_ORIGIN=
